#!/usr/bin/env bash
# shellcheck disable=SC2086
set +eou pipefail
size_limit=$((5 * 2**20))

repo_root=$(git rev-parse --show-toplevel)
pushd "$repo_root" > /dev/null 2>&1 || true

empty=$(git hash-object -t tree /dev/null)
if git rev-parse --verify HEAD > /dev/null 2>&1; then
	against=HEAD
else
	against="$empty"
fi

IFS=$'\n'
tracked=
if command -v git-lfs > /dev/null 2>&1; then
	tracked=$(git lfs ls-files --name-only 2>/dev/null)
fi
hasLargeFile=false

while IFS= read -r -d '' file; do
	for tracked_file in $tracked; do
		if [ "$file" == "$tracked_file" ]; then
			continue 2
		fi
	done
	# Inspect the staged blob even if the working copy was changed or removed.
	file_size=$(git cat-file -s ":$file" 2>/dev/null) || continue
	if [ "$file_size" -gt "$size_limit" ]; then
		echo "File $file is $((file_size / 2**20))MiB ($file_size bytes), which is larger than our configured limit of $((size_limit / 2**20))MiB ($size_limit bytes)"
		hasLargeFile=true
	fi
done < <(git diff-index --cached --name-only --diff-filter=d -z "$against")

if $hasLargeFile; then
	echo "Commit too large, did you add a binary file? For image assets, consider git-lfs."
	popd > /dev/null 2>&1 || true
	exit 1
fi

popd > /dev/null 2>&1 || true

if command -v gitleaks > /dev/null 2>&1; then
	gitleaks protect --staged --verbose --no-banner --no-color 2>/dev/null
fi
